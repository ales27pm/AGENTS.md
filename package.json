{
  "name": "agents-operations-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling and documentation for repo-native AI coding agents",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "lint": "npm run lint:markdown && npm run lint:shell",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore vendor",
    "lint:shell": "node scripts/check-shell.js",
    "format": "prettier --write \"**/*.{md,yml,yaml,json,js}\"",
    "typecheck": "tsc --pretty false --noEmit",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "markdownlint-cli": "^0.39.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
